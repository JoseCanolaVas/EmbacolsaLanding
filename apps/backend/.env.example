APP_NAME=Embacolsa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# BASE DE DATOS (Puedes usar DATABASE_URL o variables individuales)
# ==============================================================================

# Opción 1: Conexión mediante DATABASE_URL (Recomendado para PostgreSQL / Supabase / Neon / Render / RDS / MySQL)
DATABASE_URL=postgres://embacolsa_user:secret_password@127.0.0.1:5432/embacolsa_db
# Para MySQL: DATABASE_URL=mysql://embacolsa_user:secret_password@127.0.0.1:3306/embacolsa_db

# Opción 2: Conexión mediante parámetros individuales (Descomentar si no usas DATABASE_URL):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=embacolsa_db
# DB_USERNAME=embacolsa_user
# DB_PASSWORD=secret_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@embacolsa.com.co"
MAIL_FROM_NAME="${APP_NAME}"
